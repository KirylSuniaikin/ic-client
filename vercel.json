{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ic-pizza.com" }],
      "destination": "https://ic-pizza.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/auth/otp/:path*", "destination": "https://api.ic-pizza.com/api/auth/otp/:path*" },
    { "source": "/api/auth/refresh", "destination": "https://api.ic-pizza.com/api/auth/refresh" },
    { "source": "/api/auth/logout", "destination": "https://api.ic-pizza.com/api/auth/logout" }
  ],
  "headers": [
    {
      "source": "/menuImages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/branchImages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
