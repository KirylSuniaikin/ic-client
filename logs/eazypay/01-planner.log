  menuData: MenuItem[];
  refreshMenu: () => Promise<void>;
  onUnauthorized: () => void;       // opens the terminal picker
  onUnavailable: (removedNames: string[], message: string, remaining: CartItem[]) => void;
  onBranchClosed: (message: string) => void;
}

export interface UseKioskCheckoutResult {
  phase: KioskCheckoutPhase;
  submitting: boolean;
  isSheetOpen: boolean;             // true whenever phase !== "idle" — drives HomePage's noPopupOpen/anyPopupOpen
  invoiceNum: string | null;
  phoneError: string | null;
  startPhoneStep: (items: CartItem[]) => void;   // the onKioskCheckout callback passed into useCheckout
  submitPhone: (tel: string) => Promise<void>;
  confirmPayAtCounter: () => Promise<void>;       // "Yes" on the failure sheet
  declinePayAtCounter: () => Promise<void>;       // "No" on the failure sheet
  retryDefer: () => Promise<void>;                // "Try again" from error-retryable
  finishSession: () => void;                      // approved-sheet auto-return / manual close -> resetKioskSession
}
export function useKioskCheckout(params: UseKioskCheckoutParams): UseKioskCheckoutResult;

// src/domains/kiosk/utils/resetKioskSession.ts
export interface ResetKioskSessionDeps {
  // cart setters, checkout setters, kiosk-hook reset, i18n changeLanguage — one function ref per
  // item enumerated in §9. Exact field list is an implementer decision (Phase 4); every setter
  // named in §9 MUST appear here and be called exactly once.
}
export function resetKioskSession(deps: ResetKioskSessionDeps): void;

// src/domains/kiosk/hooks/useTripleClick.ts
export function useTripleClick(onTrigger: () => void, windowMs?: number): (event: React.MouseEvent) => void;
```

