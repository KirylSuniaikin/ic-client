Hibernate: WITH dough_data AS (
  SELECT
    CASE
      WHEN ((m.size = 'S')
         OR (m.size = 'M' AND i.is_thin_dough = TRUE)
         OR (m.name = 'Pizza Combo' AND ((m.size = 'S') OR (m.size = 'M' AND i.is_thin_dough = TRUE)))
      ) THEN 'S Dough'
      WHEN ((m.size = 'M')
         OR (m.size = 'L' AND i.is_thin_dough = TRUE)
         OR (m.name = 'Pizza Combo' AND ((m.size = 'M') OR (m.size = 'L' AND i.is_thin_dough = TRUE)))
      ) THEN 'M Dough'
      WHEN ((m.size = 'L' AND i.is_thin_dough = FALSE)
         OR (m.name = 'Pizza Combo' AND (m.size = 'L' AND i.is_thin_dough = FALSE))
      ) THEN 'L Dough'
      WHEN (m.category = 'Brick Pizzas' OR m.name = 'Detroit Combo') THEN 'Brick Dough'
      WHEN (m.category = 'Sides') THEN 'S Dough'
      WHEN(m.category = 'Baguette Pizzas') THEN 'S Dough'
      ELSE 'Other'
    END AS dough_type,
    (o.created_at AT TIME ZONE 'Asia/Bahrain' - interval '2 hours')::date AS shift_date,
    i.quantity
  FROM public.order_items i
  JOIN public.orders o ON o.id = i.order_id
  JOIN public.menu_items m ON i.menu_item_id = m.id
  WHERE m.category IN ('Pizzas','Combo Deals','Brick Pizzas', 'Sides', 'Baguette Pizzas')
    AND o.branch_id IN (?,?)
)
SELECT
  dd.dough_type AS doughType,
  dd.shift_date AS shiftDate,
  SUM(dd.quantity) AS qty
FROM dough_data dd
WHERE dd.shift_date BETWEEN ? AND ?
GROUP BY dd.dough_type, dd.shift_date
ORDER BY dd.dough_type, dd.shift_date

