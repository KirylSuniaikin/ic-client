Hibernate:     SELECT t.menu_item_id as menuItemId, SUM(t.amount) as amount
    FROM (
        SELECT oi.menu_item_id as menu_item_id, COUNT(*) as amount
        FROM order_items oi
        JOIN orders o ON oi.order_id = o.id
        JOIN menu_items m ON oi.menu_item_id = m.id
        WHERE o.telephone_no = ?
            AND m.category != 'Combo Deals'
        GROUP BY oi.menu_item_id

        UNION ALL

        SELECT ci.menu_item_id as menu_item_id, COUNT(*) as amount
        FROM combo_items ci
        JOIN order_items oi ON ci.order_item_id = oi.id
        JOIN orders o ON oi.order_id = o.id
        JOIN menu_items m ON ci.menu_item_id = m.id
        WHERE o.telephone_no = ?
        GROUP BY ci.menu_item_id
    ) as t
    GROUP BY t.menu_item_id
    ORDER BY amount DESC
    LIMIT 2

