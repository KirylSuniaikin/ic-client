        JOIN orders o ON oi.order_id = o.id
        WHERE o.created_at BETWEEN ? AND ?
            AND o.branch_id IN (?)
        GROUP BY m.name
    ) as t
    GROUP BY t.name
    ORDER BY amount DESC
    LIMIT 10

