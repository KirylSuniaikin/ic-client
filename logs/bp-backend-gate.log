  GROUP BY oi.menu_item_id

  UNION ALL

  SELECT ci.menu_item_id, SUM(ci.quantity) AS qty
  FROM combo_items ci
  JOIN order_items oi ON ci.order_item_id = oi.id
  JOIN orders o ON o.id = oi.order_id
  JOIN menu_items mi ON mi.id = ci.menu_item_id
  WHERE mi.category != 'Combo Deals'
    AND o.branch_id = ?
    AND o.created_at BETWEEN ? AND ?
  GROUP BY ci.menu_item_id
)
SELECT ri.component_id,
       (SUM(ri.amount * s.qty) / ?) * c.yield_multiplier AS prep_amount
FROM sold s
JOIN recipe_ingredients ri ON ri.menu_item_id = s.menu_item_id
JOIN components c ON c.id = ri.component_id
GROUP BY ri.component_id, c.yield_multiplier

